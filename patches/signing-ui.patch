+import type { SupportedLanguageCodes } from '@documenso/lib/constants/i18n';
+
+// Apenas apresentação. Não lê token, envelope, autenticação ou dados do documento.
+export function recipientLocale(
+  pathname: string,
+  basePath: string,
+  savedLanguage: unknown,
+  fallback: SupportedLanguageCodes,
+  supported: readonly string[],
+): SupportedLanguageCodes {
+  if (typeof savedLanguage === 'string' && supported.includes(savedLanguage)) {
+    return savedLanguage as SupportedLanguageCodes;
+  }
+  const prefix = `${basePath.replace(/\/$/, '')}/sign/`;
+  const remainder = pathname.startsWith(prefix) ? pathname.slice(prefix.length) : '';
+  return remainder && !remainder.startsWith('/') ? 'pt-BR' : fallback;
+}
