FROM documenso/documenso@sha256:04ac1003006e1086404e5b3aa9d748e84d8c0fd4cc5ee28938d6face9eb799ec
# Empacotamento COPY-only; sem RUN, dependencias ou dados de producao.
COPY --chown=1001:1001 output/build /app/apps/remix/build
COPY --chown=1001:1001 output/public /app/apps/remix/public
# Startup direto: preserva fallback de URL e HOSTNAME; nao executa migrations.
CMD ["sh","-c","export NEXT_PRIVATE_DIRECT_DATABASE_URL=\"${NEXT_PRIVATE_DIRECT_DATABASE_URL:-$NEXT_PRIVATE_DATABASE_URL}\"; HOSTNAME=0.0.0.0 exec node build/server/main.js"]
